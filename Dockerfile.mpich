FROM quay.io/pawsey/mpich-base:3.4.3_ubuntu24.04

# Build Python 3.13 from source and install additional dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    libffi-dev \
    libgdbm-dev \
    libc6-dev \
    libnsl-dev \
    tk-dev \
    lzma-dev \
    zlib1g-dev \
    wget \
    git \
    wcslib-dev && \
    PYTHON_VERSION=$(wget -qO- https://www.python.org/ftp/python/ | grep -oP '3\.13\.\d+/' | tail -1 | tr -d '/') && \
    wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar xzf Python-${PYTHON_VERSION}.tgz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure --enable-optimizations --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf Python-${PYTHON_VERSION} Python-${PYTHON_VERSION}.tgz && \
    update-alternatives --install /usr/bin/python python /usr/local/bin/python3.13 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/local/bin/python3.13 1 && \
    /usr/local/bin/python3.13 -m pip install --upgrade pip && \
    rm -rf /var/lib/apt/lists/*

# Copy and install Python requirements
COPY requirements.txt /tmp/requirements.txt

# Install requirements, but compile mpi4py with MPI compilers from base image
# The Pawsey base image has mpicc/mpif90 for Cray MPICH at /usr/bin
RUN pip install --no-cache-dir --break-system-packages \
    $(grep -v mpi4py /tmp/requirements.txt | tr '\n' ' ')

# Build and install mpi4py with explicit MPI configuration
# Set environment variables to ensure proper linking against Cray MPICH
RUN MPICC=/usr/bin/mpicc \
    LDFLAGS="-L/usr/lib -Wl,-rpath,/usr/lib" \
    LD_LIBRARY_PATH="/usr/lib:$LD_LIBRARY_PATH" \
    pip install --no-cache-dir --break-system-packages --no-binary :all: mpi4py

# Build and install Sofia2
RUN cd /tmp && \
    git clone https://gitlab.com/SoFiA-Admin/SoFiA-2.git && \
    cd SoFiA-2 && \
    make OMP=true && \
    make install DESTDIR=/usr/bin && \
    cd .. && \
    rm -rf SoFiA-2
